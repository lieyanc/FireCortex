{
  "name": "@firecortex/desktop",
  "version": "0.4.6-fc.2",
  "private": true,
  "type": "module",
  "description": "FireCortex desktop shell (Tauri). Loads the apps/web static build and adds tray, deep links and OS keychain storage.",
  "scripts": {
    "sync:version": "node ../../scripts/sync-version.mjs desktop",
    "check:version": "node ../../scripts/sync-version.mjs --check desktop",
    "tauri": "tauri",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tauri build",
    "build:app": "node scripts/build-app.mjs",
    "check": "pnpm check:version && cargo check --manifest-path src-tauri/Cargo.toml",
    "build:signed": "bash scripts/build-signed.sh",
    "package:portable": "node scripts/package-portable.mjs",
    "test": "node --test 'scripts/*.test.mjs'"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5"
  }
}
